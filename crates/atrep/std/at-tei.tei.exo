>-@

@-> =(pubplace)
<pubPlace>@(grammata)</pubPlace>
>-@

@-> =(date)
<date>@(grammata)</date>
>-@

@-> =(idno)
<idno>@(grammata)</idno>
>-@

@-> =(extent)
<extent>@(grammata)</extent>
>-@

@-> =(edition)
<edition>@(grammata)</edition>
