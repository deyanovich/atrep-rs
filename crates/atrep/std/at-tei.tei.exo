>-@

@-> =(note)
<note>@(grammata)</note>
>-@

@-> =
<note type="@(lemma)">@(grammata)</note>
>-@

@-> *verbatim
<code@[ lang="@(genoses)"]@>@(content)</code>
>-@

@-> *verbatim-inline
<code>@(content)</code>
>-@

@-> *media
<graphic url="@((param))"/>
>-@

@-> *onym-anchor
<anchor xml:id="@(onym)"/>
>-@

@-> *diaphane
@(grammata)
>-@

@-> *diaphane-inline
@[<choice><orig>@(paradosis)</orig><reg>]@@(grammata)@[@(?paradosis)</reg></choice>]@
>-@
