@@@!atrep-exo
@=at-tei=>tei

@@/ TEI P5 export for the at-tei syntax mapper. Genos variants
@@/ restore the camelCase element names; the flat fileDesc in
@@/ the header is schema-loose (strict titleStmt grouping is a
@@/ follow-up). Unknown genoses fall back to seg/ab with a type
@@/ attribute, so free genoses survive the trip.
@@/ The unseen attributes come from at-aphanes monosims held
@@/ inside the span, read through sim-name slots: who from
@@/ prosopon, ref from prosopon/chora/syllogos, target from
@@/ skopos, when from chronos, ana from eidos (one category per
@@/ monosim; a TEI ana with several pointers is a recorded
@@/ limitation of the slot join). A diaphane that holds a
@@/ paradosis renders as <choice> with the transmitted form as
@@/ <orig> and the reading as <reg> (a gate slot closes the
@@/ element only when the value is present); which of abbr, sic
@@/ or orig the source used is not kept.

@%
& &amp;
< &lt;
> &gt;
%@

@-> *document
<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0">
@(grammata)
</TEI>
>-@

@-> *paragraph
<p@[ ana="#@(eidos)"]@>@(grammata)</p>
>-@

@-> _.teiheader
<teiHeader>
<fileDesc>
@(grammata)
</fileDesc>
</teiHeader>
>-@

@-> _.text
<text>
<body>
@(grammata)
</body>
</text>
>-@

@-> #
<div@[ xml:id="@(onym)"]@@[ type="@(genoses)"]@@[ n="@(taxis)"]@>
@[<head>@(lemma)</head>
]@@(grammata)
</div>
>-@

@-> #.front
<front>
@[<head>@(lemma)</head>
]@@(grammata)
</front>
>-@

@-> #.back
<back>
@[<head>@(lemma)</head>
]@@(grammata)
</back>
>-@

@-> _.quote
<quote@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</quote>
>-@

@-> _.cit
<cit@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</cit>
>-@

@-> _.epigraph
<epigraph@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</epigraph>
>-@

@-> _.argument
<argument@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</argument>
>-@

@-> _.stage
<stage@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</stage>
>-@

@-> _.postscript
<postscript@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</postscript>
>-@

@-> _.salute
<salute@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</salute>
>-@

@-> _.signed
<signed@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</signed>
>-@

@-> _.opener
<opener@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</opener>
>-@

@-> _.closer
<closer@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</closer>
>-@

@-> _.trailer
<trailer@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</trailer>
>-@

@-> _.dateline
<dateline@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</dateline>
>-@

@-> _.byline
<byline@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</byline>
>-@

@-> _.address
<address@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</address>
>-@

@-> _.floatingtext
<floatingText@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</floatingText>
>-@

@-> _.formula
<formula@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</formula>
>-@

@-> _
<ab@[ type="@(genoses)"]@@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</ab>
>-@

@-> ,.emph
<emph>@(grammata)</emph>
>-@

@-> ,.hi
<hi>@(grammata)</hi>
>-@

@-> ,.foreign
<foreign>@(grammata)</foreign>
>-@

@-> ,.term
<term>@(grammata)</term>
>-@

@-> ,.mentioned
<mentioned>@(grammata)</mentioned>
>-@

@-> ,.socalled
<soCalled>@(grammata)</soCalled>
>-@

@-> ,.said
<said@[ who="#@(prosopon)"]@@[ ana="#@(eidos)"]@>@(grammata)</said>
>-@

@-> ,.said.indirect
<said direct="false"@[ who="#@(prosopon)"]@@[ ana="#@(eidos)"]@>@(grammata)</said>
>-@

@-> ,.said.thought
<said aloud="false"@[ who="#@(prosopon)"]@@[ ana="#@(eidos)"]@>@(grammata)</said>
>-@

@-> ,.said.indirect.thought
<said direct="false" aloud="false"@[ who="#@(prosopon)"]@@[ ana="#@(eidos)"]@>@(grammata)</said>
>-@

@@/ Litogramma's quotation arrives as `.q` with `.said` already
@@/ on it when it is speech; the two-genos variants break the tie
@@/ in favour of said.
@-> ,.said.q
<said@[ who="#@(prosopon)"]@@[ ana="#@(eidos)"]@>@(grammata)</said>
>-@

@-> ,.said.q.indirect
<said direct="false"@[ who="#@(prosopon)"]@@[ ana="#@(eidos)"]@>@(grammata)</said>
>-@

@-> ,.said.q.thought
<said aloud="false"@[ who="#@(prosopon)"]@@[ ana="#@(eidos)"]@>@(grammata)</said>
>-@

@-> ,.said.q.indirect.thought
<said direct="false" aloud="false"@[ who="#@(prosopon)"]@@[ ana="#@(eidos)"]@>@(grammata)</said>
>-@

@-> ,.q
<q@[ who="#@(prosopon)"]@@[ ana="#@(eidos)"]@>@(grammata)</q>
>-@

@-> ,.persname
<persName@[ ref="#@(prosopon)"]@>@(grammata)</persName>
>-@

@-> ,.placename
<placeName@[ ref="#@(chora)"]@>@(grammata)</placeName>
>-@

@-> ,.orgname
<orgName@[ ref="#@(syllogos)"]@>@(grammata)</orgName>
>-@

@-> ,.name
<name@[ ref="#@(prosopon)"]@@[ ref="#@(chora)"]@@[ ref="#@(syllogos)"]@>@(grammata)</name>
>-@

@-> ,.rs
<rs@[ ref="#@(prosopon)"]@@[ ref="#@(chora)"]@@[ ref="#@(syllogos)"]@>@(grammata)</rs>
>-@

@-> ,.date
<date@[ when="@(chronos)"]@>@(grammata)</date>
>-@

@-> ,.ref
<ref@[ target="@(skopos)"]@>@(grammata)</ref>
>-@

@-> ,.time
<time>@(grammata)</time>
>-@

@-> ,.num
<num>@(grammata)</num>
>-@

@-> ,.measure
<measure>@(grammata)</measure>
>-@

@-> ,.title
<title>@(grammata)</title>
>-@

@-> ,.gloss
<gloss>@(grammata)</gloss>
>-@

@-> ,.distinct
<distinct>@(grammata)</distinct>
>-@

@-> ,.abbr
<abbr>@(grammata)</abbr>
>-@

@-> ,.expan
<expan>@(grammata)</expan>
>-@

@-> ,.sic
<sic>@(grammata)</sic>
>-@

@-> ,.corr
<corr>@(grammata)</corr>
>-@

@-> ,.reg
<reg>@(grammata)</reg>
>-@

@-> ,.orig
<orig>@(grammata)</orig>
>-@

@-> ,.add
<add>@(grammata)</add>
>-@

@-> ,.del
<del>@(grammata)</del>
>-@

@-> ,.unclear
<unclear>@(grammata)</unclear>
>-@

@-> ,.supplied
<supplied>@(grammata)</supplied>
>-@

@-> ,.seg
<seg@[ ana="#@(eidos)"]@>@(grammata)</seg>
>-@

@-> ,.code
<code>@(grammata)</code>
>-@

@-> ,.formula
<formula>@(grammata)</formula>
>-@

@-> ,
<seg@[ type="@(genoses)"]@@[ ana="#@(eidos)"]@>@(grammata)</seg>
>-@

@-> ~
<lg@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)@[
<bibl>@(hypograph)</bibl>]@
</lg>
>-@

@-> *strophe
<lg type="strophe">
@(grammata)
</lg>
>-@

@-> *stichos
<l>@(grammata)</l>
>-@

@-> :
<sp@[ who="#@(prosopon)"]@>
@[<speaker>@(lemma)</speaker>
]@@(grammata)
</sp>
>-@

@-> :(
<stage>@(grammata)</stage>
>-@

@-> ^
<note@[ xml:id="@(onym)"]@@[ place="@(genoses)"]@>
@(grammata)
</note>
>-@

@-> *deixis ^
<ptr target="#@(onym)"/>
>-@

@-> --
<list@[ type="@(genoses)"]@>
@(grammata)
</list>
>-@

@-> --.castlist
<castList>
@(grammata)
</castList>
>-@

@-> -
<item>@[<label>@(lemma)</label> ]@@(grammata)</item>
>-@

@-> +
<table@[ xml:id="@(onym)"]@>
@[<head>@(lemma)</head>
]@@(grammata)
