>-@

@-> *row + |
<row>@(cells)</row>
>-@

@-> *cell +
<cell>@(grammata)</cell>
>-@

@-> <
<figure@[ xml:id="@(onym)"]@>
@(grammata)@[
<head>@(lemma)</head>]@
</figure>
>-@

@-> ><
<ref target="@((grammata))"/>
>-@

@-> >
<ptr target="#@(param)"/>
>-@

@-> |.lb
<lb/>
>-@

@-> |.pb
<pb@[ n="@(param)"]@/>
>-@

@-> |.cb
<cb/>
>-@

@-> |.milestone
<milestone@[ n="@(param)"]@/>
>-@

@-> |
<milestone@[ n="@(param)"]@/>
>-@

@-> =(title)
<title>@(grammata)</title>
>-@

@-> =(author)
<author>@(grammata)</author>
>-@

@-> =(editor)
<editor>@(grammata)</editor>
>-@

@-> =(translator)
<translator>@(grammata)</translator>
>-@

@-> =(publisher)
